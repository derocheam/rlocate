[Unit]
Description=rlocate query server
Documentation=https://github.com/derocheam/rlocate
After=network-online.target
Wants=network-online.target
# Don't start until an index exists (the server mmaps it at startup).
ConditionPathExists=/var/lib/rlocate/rlocate.db

[Service]
Type=simple
# Token as an encrypted systemd credential: decrypted at start into a private
# tmpfs at %d/token (0400, service-only), never on disk in plaintext, never in
# the environment. Create /etc/rlocate/token.cred with:
#   systemd-creds encrypt --name=token - /etc/rlocate/token.cred
# (type the token, then Ctrl-D). See packaging/README.md.
LoadCredentialEncrypted=token:/etc/rlocate/token.cred
ExecStart=/usr/local/bin/rlocate --serve --listen 0.0.0.0:9999 --database /var/lib/rlocate/rlocate.db --token-file %d/token
Restart=on-failure
RestartSec=2

# Light hardening: the server only reads the index, never writes.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
